# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Verilog source files
*.v text eol=lf
*.sv text eol=lf
*.vh text eol=lf

# Python, Shell & Scripts
*.py text eol=lf
*.sh text eol=lf
*.tcl text eol=lf
*.pcf text eol=lf
*.xdc text eol=lf
*.json text eol=lf

# Markdown & LaTeX
*.md text eol=lf
*.tex text eol=lf

# Binary Assets
*.png binary
*.jpg binary
*.pdf binary
